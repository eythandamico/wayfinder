{
  "name": "wayfinder-vite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/post-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2025-01-01 --port 8788",
    "pages:deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource/geist-mono": "^5.1.0",
    "@gsap/react": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.8.0",
    "motion": "^12.40.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-jazzicon": "^1.0.4",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260616.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "eslint": "^9",
    "globals": "^17.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
